{
  "name": "smarter.sh",
  "version": "0.3.5",
  "description": "An AI resource orchestration platform.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx}'",
    "audit": "yarn audit",
    "start": "vite",
    "prettify": "prettier src/**/*.js --write",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "release": "node release.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.1",
    "@fortawesome/react-fontawesome": "^3.0.2",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/forms": "^0.5.9",
    "aos": "^2.3.4",
    "clsx": "^2.1.1",
    "glightbox": "^3.3.0",
    "gumshoejs": "^5.1.2",
    "preline": "^2.5.1",
    "prettier": "^3.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.9.3",
    "react-text-typist": "^1.1.8",
    "swiper": "^12.0.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^9.39.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/aos": "^3.0.7",
    "@types/node": "^24.7.2",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.47",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "semantic-release": "^24.2.9",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^7.1.9"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:prettier/recommended"
    ]
  },
  "prettier": {
    "printWidth": 90,
    "bracketSpacing": true,
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --ignore-pattern src/assets/",
      "prettier --ignore-path .prettierignore --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "index.js",
  "license": "MIT",
  "author": "Lawrence McDaniel",
  "bugs": {
    "url": "https://github.com/smarter-sh/smarter.sh/issues"
  },
  "homepage": "/",
  "repository": "https://github.com/smarter-sh/smarter.sh.git",
  "keywords": [
    "Smarter",
    "AI"
  ],
  "contributors": [
    {
      "name": "Lawrence McDaniel",
      "email": "lpm0073@gmail.com",
      "url": "https://lawrencemcdaniel.com"
    },
    {
      "name": "Shalim Mora",
      "email": "shalimhoms@gmail.com",
      "url": "https://www.shalimmora.com/"
    }
  ],
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}

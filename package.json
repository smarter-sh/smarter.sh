{
  "name": "smarter.sh",
  "version": "0.1.0",
  "description": "smarter.sh is an AI resource orchestration platform.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx}'",
    "audit": "yarn audit",
    "start": "vite",
    "prettify": "prettier src/**/*.js --write",
    "prepare": "husky install",
    "release": "node release.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.1",
    "@fortawesome/free-brands-svg-icons": "^7.0.1",
    "@fortawesome/react-fontawesome": "^3.0.2",
    "@iconify/react": "^5.0.2",
    "@tailwindcss/forms": "^0.5.9",
    "aos": "^2.3.4",
    "clsx": "^2.1.1",
    "glightbox": "^3.3.0",
    "gumshoejs": "^5.1.2",
    "preline": "^2.5.1",
    "prettier": "^3.3.3",
    "react": "19.0.0",
    "react-dom": "19.1.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.27.0",
    "react-text-typist": "^1.1.8",
    "swiper": "^11.1.14",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/aos": "^3.0.7",
    "@types/node": "^22.7.7",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:prettier/recommended"
    ]
  },
  "prettier": {
    "printWidth": 90,
    "bracketSpacing": true,
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --ignore-pattern src/assets/",
      "prettier --ignore-path .prettierignore --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "index.js",
  "license": "MIT",
  "author": "Lawrence McDaniel",
  "bugs": {
    "url": "https://github.com/smarter-sh/smarter.sh/issues"
  },
  "homepage": "/",
  "repository": "https://github.com/smarter-sh/smarter.sh.git",
  "keywords": [
    "Smarter",
    "AI"
  ],
  "contributors": [
    {
      "name": "Lawrence McDaniel",
      "email": "lpm0073@gmail.com",
      "url": "https://lawrencemcdaniel.com"
    },
    {
      "name": "Shalim Mora",
      "email": "shalimhoms@gmail.com",
      "url": "https://www.shalimmora.com/"
    }
  ],
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
